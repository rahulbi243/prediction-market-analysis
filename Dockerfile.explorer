# ── Prediction Market KG Explorer — Render deployment ────────────────────────
# Runs FastAPI + pyoxigraph (no Java/Fuseki required).
# The N-Quads dump (graph.nq) is baked in at build time.
#
# Build:
#   uv run python scripts/export_kg.py   # generates graph.nq first
#   docker build -f Dockerfile.explorer -t pmo-explorer .
#
# Run:
#   docker run -p 8765:8765 pmo-explorer

FROM python:3.11-slim

WORKDIR /app

# ── System deps ───────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── Python deps (v2 — bust Render cache) ────────────────────────────────────
RUN pip install --no-cache-dir \
    fastapi>=0.111.0 \
    "uvicorn[standard]>=0.30.0" \
    pyoxigraph>=0.3.22 \
    httpx>=0.28.1 \
    openai>=1.0.0 \
    SPARQLWrapper>=2.0.0 \
    duckdb>=1.0.0

# ── App source ────────────────────────────────────────────────────────────────
COPY src/__init__.py                 src/__init__.py
COPY src/kg/                         src/kg/
COPY src/agent/__init__.py           src/agent/__init__.py
COPY src/agent/llm.py                src/agent/llm.py
COPY src/analysis/__init__.py        src/analysis/__init__.py
COPY src/analysis/kalshi/__init__.py src/analysis/kalshi/__init__.py
COPY src/analysis/kalshi/util/       src/analysis/kalshi/util/

# ── Pre-baked KG data (generated by scripts/export_kg.py) ────────────────────
COPY src/kg/explorer/static/graph.nq src/kg/explorer/static/graph.nq
COPY src/kg/explorer/static/data.json src/kg/explorer/static/data.json

# ── Data directory for SQLite pipeline runs DB ───────────────────────────────
RUN mkdir -p /app/data

# ── Entrypoint ────────────────────────────────────────────────────────────────
ENV EXPLORER_PORT=8765
ENV KG_DATA_PATH=src/kg/explorer/static/graph.nq
ENV PYTHONUNBUFFERED=1

EXPOSE 8765

CMD ["uvicorn", "src.kg.explorer.app:app", "--host", "0.0.0.0", "--port", "8765"]
