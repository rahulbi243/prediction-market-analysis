# ── Prediction Market KG Explorer — Render deployment ────────────────────────
# Runs FastAPI + pyoxigraph (no Java/Fuseki required).
# The N-Quads dump (graph.nq) is baked in at build time.
#
# Build:
#   uv run python scripts/export_kg.py   # generates graph.nq first
#   docker build -f Dockerfile.explorer -t pmo-explorer .
#
# Run:
#   docker run -p 8765:8765 pmo-explorer

FROM python:3.11-slim

WORKDIR /app

# ── System deps ───────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── Python deps (only what the explorer needs) ───────────────────────────────
RUN pip install --no-cache-dir \
    fastapi>=0.111.0 \
    "uvicorn[standard]>=0.30.0" \
    pyoxigraph>=0.3.22 \
    httpx>=0.28.1

# ── App source ────────────────────────────────────────────────────────────────
COPY src/kg/__init__.py              src/kg/__init__.py
COPY src/kg/client.py                src/kg/client.py
COPY src/kg/client_oxigraph.py       src/kg/client_oxigraph.py
COPY src/kg/explorer/                src/kg/explorer/

# ── Pre-baked KG data (generated by scripts/export_kg.py) ────────────────────
COPY src/kg/explorer/static/graph.nq src/kg/explorer/static/graph.nq

# ── Entrypoint ────────────────────────────────────────────────────────────────
ENV EXPLORER_PORT=8765
ENV KG_DATA_PATH=src/kg/explorer/static/graph.nq

EXPOSE 8765

CMD ["uvicorn", "src.kg.explorer.app:app", "--host", "0.0.0.0", "--port", "8765"]
